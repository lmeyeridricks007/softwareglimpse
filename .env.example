# Public site origin used for canonical URLs, sitemaps, and structured data.
NEXT_PUBLIC_SITE_URL=https://www.softwareglimpse.com

# Future secrets — never expose server-only keys to the client.
# ANALYTICS_MEASUREMENT_ID=
# AFFILIATE_API_KEY=
# AI_PROVIDER_API_KEY=

# Future research providers (optional — fixture pipeline works without these)
# RESEARCH_WEB_SEARCH_API_KEY=
# RESEARCH_FETCH_API_KEY=
# RESEARCH_AI_EXTRACTOR_API_KEY=

# SERP competitor discovery (approved APIs only — never scrape Google HTML)
# Prefer one of:
# SERP_SEARCH_PROVIDER=brave
# BRAVE_API_KEY=
# SERPER_API_KEY=
# GOOGLE_CUSTOM_SEARCH_API_KEY=
# GOOGLE_CUSTOM_SEARCH_ID=
# Offline: npm run site:serp-competitors -- --fixture
#          npm run site:serp-competitors -- --import <snapshot.json>

# Google Search Console (optional — Site Intelligence + SEO sync)
# Approved connector interface exists; live googleapis client is not shipped yet.
# Do NOT scrape Search Console HTML. Do NOT invent credentials.
#
# When ready for live API:
#   GSC_PROPERTY_URL=https://www.softwareglimpse.com/
#   GSC_CLIENT_EMAIL=
#   GOOGLE_APPLICATION_CREDENTIALS=
#
# Until then, use approved export import or synthetic fixtures:
#   npm run site:search-performance -- --import path/to/gsc-export.json
#   npm run site:search-performance -- --fixture
#   npm run seo:sync -- --fixture
#
# Optional override for SEO data root (default: src/data/seo)
# SG_SEO_ROOT=
# SG_SEO_FIXTURES=
# SG_SEARCH_PERF_ALLOW_FIXTURE_FALLBACK=1

# Vercel Blob (public media for guides/software screenshots — not for marketing week packs)
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=
# BLOB_PUBLIC_HOST=https://xxxxx.public.blob.vercel-storage.com
