  "decisionHub": {
    "whatItIs": "Magento (Adobe) is the enterprise-leaning open commerce stack: Magento Open Source is free to download; Adobe Commerce is a GMV-based commercial license (partner estimates commonly cite ~$22k+/year floors — exact quotes only). Buyers own hosting, DevOps, and extension TCO. Strong for complex catalogs and B2B; not an SMB SaaS launch path. Research grounded 2026-08-18 from Adobe positioning and industry license ranges — not a published Adobe price list.",
    "bestFor": [
      "Mid-market and enterprise catalogs with complex B2B needs",
      "Teams with Magento/Adobe partner capacity",
      "Merchants who outgrew WooCommerce simplicity and need deeper commerce core",
      "mid-market / operations: Magento fit for mid-market operations teams in the open-source-platform job cluster, from first-party positioning and Ecommerce Priority-1 research.",
      "enterprise / operations: Magento fit for enterprise operations teams in the open-source-platform job cluster, from first-party positioning and Ecommerce Priority-1 research."
    ],
    "notIdealFor": [
      "Solo founders wanting a weekend store launch",
      "Website-first brands that mainly need pages + light commerce (see Wix/Squarespace)",
      "Buyers who need published monthly plan tiles only",
      "Operational and agency TCO is high versus hosted SaaS even when the Open Source license is $0",
      "Adobe Commerce pricing is opaque (GMV quote) — hard to compare without a partner worksheet",
      "Implementation timelines are measured in months, not a weekend theme install"
    ],
    "coreCapabilities": [
      "online storefront",
