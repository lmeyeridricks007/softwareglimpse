  "decisionHub": {
    "whatItIs": "Grafana Cloud is Grafana Labs’ managed metrics/logs/traces/profiles stack (Mimir, Loki, Tempo, Pyroscope) plus Grafana. Free includes 10,000 active series, 50 GB logs/traces/profiles, 3 users, 14-day retention. Pro adds a published ~$19/month platform fee, longer retention, and usage rates (commonly $6.50 per 1,000 billable series and $8 per active visualisation user). Enterprise/Advanced is a spend-commit (~$25k/year cited) custom contract. Self-hosted Grafana OSS remains free and is a different buying motion.",
    "bestFor": [
      "Teams already fluent in Grafana/Prometheus",
      "Startups that fit in the Free telemetry caps",
      "Platform teams that want Mimir/Loki without operating it",
      "small-business / engineering: Grafana Cloud fit for small-business engineering teams in the observability-monitoring job cluster, from first-party positioning and IT Priority-2 research.",
      "mid-market / engineering: Grafana Cloud fit for mid-market engineering teams in the observability-monitoring job cluster, from first-party positioning and IT Priority-2 research.",
      "enterprise / engineering: Grafana Cloud fit for enterprise engineering teams in the observability-monitoring job cluster, from first-party positioning and IT Priority-2 research."
    ],
    "notIdealFor": [
      "Buyers who want Datadog-style host SKUs and a single APM vendor UX",
      "ITSM desks (Freshservice)",
      "On-call-only (PagerDuty)",
      "Pro bills many usage dimensions — the $19 fee is not the bill",
      "Free retention is 14 days — production teams usually need Pro",
      "Enterprise security (SAML, audit) is not the Free/Pro default story"
    ],
    "coreCapabilities": [
      "incident management",
      "infrastructure monitoring",
      "apm tracing",
      "log management",
      "cicd actions",
      "itsm ai",
