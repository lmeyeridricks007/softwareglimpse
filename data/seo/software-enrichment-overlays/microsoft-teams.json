  "decisionHub": {
    "whatItIs": "Microsoft Teams is scored here as a team-messaging and collaboration hub, not as a peer cloud-phone product. Free Teams and Microsoft 365 Plans include chat and meetings; Teams Phone Standard (~$10/user/month annual) plus PSTN (PAYG ~$13 / Calling Plan ~$17 / Domestic+International ~$34) is a telephony add-on that also requires an eligible Teams/M365 licence. October 2023 Teams unbundling means Teams is no longer assumed free inside every Microsoft 365 SKU — verify licence packaging.",
    "bestFor": [
      "Organisations standardised on Microsoft 365 that need chat and meetings as the collaboration hub",
      "Enterprises that may add Teams Phone later for PSTN without changing collaboration vendors",
      "IT-led rollouts that prioritise identity, compliance and app ecosystem over dialer features",
      "small-business / operations: Microsoft Teams fit for small-business operations teams in the team-messaging job cluster, from first-party positioning and business-communications Priority-1 research.",
      "mid-market / operations: Microsoft Teams fit for mid-market operations teams in the team-messaging job cluster, from first-party positioning and business-communications Priority-1 research.",
      "enterprise / operations: Microsoft Teams fit for enterprise operations teams in the team-messaging job cluster, from first-party positioning and business-communications Priority-1 research."
    ],
    "notIdealFor": [
      "Buyers shortlisting a primary cloud phone / contact-centre system",
      "Sales teams that need power dialer, SMS campaigns or WhatsApp Business",
      "Companies unwilling to navigate M365 licence + Teams Phone + PSTN stacking",
      "Scored as a collaboration hub — Teams Phone is a telephony add-on, not the primary scored job",
      "Teams Phone requires an eligible Teams/M365 licence plus PSTN (PAYG or Calling Plan)",
      "October 2023 Teams unbundling means Teams is not free inside every Microsoft 365 SKU"
    ],
