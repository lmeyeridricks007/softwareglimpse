    {
      "claim": "Sales Cloud is Salesforce’s CRM for sales teams — from Starter Suite for smaller teams through Enterprise/Unlimited for advanced pipeline, AI, and developer/admin depth.",
      "audienceHints": [
        "mid-market sales orgs",
        "enterprise sales teams",
        "complex multi-cloud buyers"
      ],
      "sourceIds": [
        "salesforce-sales-cloud-product",
        "salesforce-sales-cloud-pricing",
        "salesforce-crm-product"
      ]
    }
  ],
  "editorialFit": [
    {
      "businessSizeSlug": "enterprise",
      "strength": "strong",
      "rationale": "Enterprise/Unlimited editions, API/sandbox depth, and ecosystem fit large complex orgs.",
      "isEditorial": true
    },
    {
      "businessSizeSlug": "mid-market",
      "strength": "strong",
      "rationale": "Pro Suite and Enterprise cover forecasting, customization, and pipeline sophistication common in mid-market sales.",
      "isEditorial": true
    },
    {
      "businessSizeSlug": "small-business",
      "strength": "moderate",
      "rationale": "Starter Suite exists at $25/user/mo, but Salesforce remains heavier than SMB-first CRMs.",
      "isEditorial": true
    },
    {
      "teamTypeSlug": "sales",
      "strength": "strong",
      "rationale": "Sales Cloud is explicitly sales CRM oriented.",
      "isEditorial": true
    }
  ],
  "limitations": [
    {
      "kind": "high-cost-at-scale",
      "description": "USD list pricing rises quickly: Pro Suite $100, Enterprise $175, Unlimited $350 per user/month (annual). Add-ons (Agentforce for Sales from $125 Contact us, Revenue Intelligence, Success Plans) increase TCO.",
      "sourceIds": [
        "salesforce-sales-cloud-pricing",
        "salesforce-crm-pricing"
      ],
      "isEditorial": false
    },
    {
      "kind": "requires-add-on",
      "description": "Premier Support is an add-on on Pro Suite. Agentforce for Sales, Sales Programs, Revenue Intelligence, and Revenue Cloud are separate paid add-ons; some require Contact us.",
      "sourceIds": [
        "salesforce-sales-cloud-pricing"
      ],
      "isEditorial": false
    },
    {
      "kind": "plan-restriction",
      "description": "Pro Suite, Enterprise, Unlimited, and Agentforce 1 Sales list prices are billed annually on the pricing page; only Starter Suite explicitly offers monthly or annual at the same $25 USD list rate.",
      "sourceIds": [
        "salesforce-sales-cloud-pricing"
      ],
      "isEditorial": false
    },
    {
      "kind": "feature-unavailable",
      "description": "Not a lightweight SMB CRM — administration, implementation, and configuration overhead are part of the platform tradeoff versus Pipedrive-style tools.",
      "sourceIds": [
        "salesforce-sales-cloud-product",
        "salesforce-crm-product",
        "salesforce-sales-cloud-features"
      ],
      "isEditorial": true
    }
  ],
