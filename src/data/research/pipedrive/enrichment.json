  "limitations": [
    {
      "kind": "plan-restriction",
      "description": "Lite lacks full email sync and workflow automation — most active sales teams need Growth or higher.",
      "sourceIds": [
        "pipedrive-plans-kb",
        "pipedrive-pricing-official"
      ],
      "isEditorial": false
    },
    {
      "kind": "requires-add-on",
      "description": "Campaigns and Web Visitors remain paid add-ons on all plans; LeadBooster/Projects/Smart Docs are add-ons below Premium.",
      "sourceIds": [
        "pipedrive-pricing-how-kb"
      ],
      "isEditorial": false
    },
    {
      "kind": "usage-cap",
      "description": "Ultimate introduces explicit caps (e.g. custom fields, teams, reports) versus the older unlimited Enterprise packaging.",
      "sourceIds": [
        "pipedrive-plans-kb"
      ],
      "isEditorial": false
    },
    {
      "kind": "feature-unavailable",
      "description": "Native full telephony/AI suite calling is limited compared with Freshsales-style all-in-one phone + scoring bundles; deeper calling relies on Marketplace apps.",
      "sourceIds": [
        "pipedrive-plans-kb",
        "pipedrive-marketplace"
      ],
      "isEditorial": true
    },
    {
      "kind": "high-cost-at-scale",
      "description": "Per-seat pricing plus add-ons can climb quickly for larger teams if Premium bundles are not used carefully.",
      "sourceIds": [
        "pipedrive-pricing-official",
        "pipedrive-pricing-how-kb"
      ],
      "isEditorial": true
    }
  ],
